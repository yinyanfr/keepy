{
  "name": "keepy",
  "version": "1.0.0",
  "description": "Yet another telegram bookkeeping bot (with bonus mini app)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/app.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "serve": "npm run build && pm2 startOrReload ecosystem.config.cjs --update-env",
    "serve:logs": "pm2 logs keepy",
    "serve:stop": "pm2 stop keepy",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinyanfr/keepy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yinyanfr/keepy/issues"
  },
  "homepage": "https://github.com/yinyanfr/keepy#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "grammy": "^1.43.0",
    "pm2": "^7.0.1"
  },
  "overrides": {
    "js-yaml": "^5.2.3"
  }
}
